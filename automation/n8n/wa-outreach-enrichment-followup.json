    {
      "parameters": {
        "functionCode": "// Cek duplikat berdasarkan sent_log\nconst lead = $item(0).$node['Normalisasi Payload'].json;\nconst row = $json || {};\nconst duplicate = Boolean(row.timestamp && row.nomor_wa);\n\nif (duplicate) {\n  console.log('duplicate skipped');\n  return [{ json: { ...lead, duplicate: true, duplicate_log: 'duplicate skipped' } }];\n}\n\nreturn [{ json: { ...lead, duplicate: false } }];"
      },
