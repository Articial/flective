      "parameters": {
        "functionCode": "// Parse JSON follow-up dari OpenAI\nif ($json.error) {\n  throw new Error(`OpenAI followup gagal: ${$json.error.message || 'unknown error'}`);\n}\n\nconst rawText = String($json.choices?.[0]?.message?.content || '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(rawText);\n} catch (e) {\n  const match = rawText.match(/\\{[\\s\\S]*\\}/);\n  if (!match) throw new Error('Respons followup bukan JSON valid');\n  parsed = JSON.parse(match[0]);\n}\n\nreturn [{\n  json: {\n    ...$item(0).$node['Check Needs Followup'].json,\n    followup_text: String(parsed.followup_text || '').trim()\n  }\n}];"
