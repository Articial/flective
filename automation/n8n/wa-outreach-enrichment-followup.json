    {
      "parameters": {
        "functionCode": "// Filter event reply dari WAHA\nconst body = $json.body || $json;\nconst event = body.event || body.type || '';\nconst payload = body.payload || body.data || body;\nconst fromMe = Boolean(payload.fromMe);\nconst chatId = String(payload.chatId || payload.from || '');\nconst nomorWa = chatId.replace(/@.*/, '').replace(/[^0-9]/g, '');\nconst text = String(payload.body || payload.text || payload.message || '').trim();\n\nif (event !== 'message' || fromMe || !nomorWa || !text) {\n  return [];\n}\n\nreturn [{ json: { event, chatId, nomor_wa: nomorWa, incoming_text: text } }];"
      },
